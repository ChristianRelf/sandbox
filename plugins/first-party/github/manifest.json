    {
      "nodeType": "github.issue_or_pull_request_changed",
      "nodeVersion": 1,
      "displayName": "Issue or Pull Request Changed",
      "description": "Starts when an issue or pull request snapshot changes.",
      "category": "Triggers",
      "riskLevel": "low",
      "inputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "configurationSchema": {
        "type": "object",
        "properties": {
          "connectionId": {
            "type": "string",
            "title": "Connection",
            "format": "connection",
            "x-sndbox-provider": "github_app"
          },
          "repository": {
            "type": "string",
            "title": "Repository",
            "description": "owner/repository"
          },
          "recordType": {
            "type": "string",
            "title": "Record type",
            "enum": [
              "issue",
              "pull_request",
              "both"
            ],
            "default": "both"
          },
          "state": {
            "type": "string",
            "title": "State",
            "enum": [
              "open",
              "closed",
              "all"
            ],
            "default": "all"
          },
          "labels": {
            "type": "array",
            "title": "Labels",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "actors": {
            "type": "array",
            "title": "Actors",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "pollIntervalSeconds": {
            "type": "integer",
            "title": "Poll interval (seconds)",
            "minimum": 60,
            "maximum": 300,
            "default": 120
          }
        },
        "required": [
          "connectionId",
          "repository"
        ],
        "additionalProperties": false
      },
      "credentialRequirements": [
        "github_app"
      ],
      "capabilities": [
        "credential_operations:github_app",
        "structured_logging"
      ],
      "timeoutMs": 30000,
      "retryBehavior": "safe",
      "idempotencySupport": "read_only",
      "documentation": "docs/github.issue_or_pull_request_changed.md",
      "migrationHandlers": [],
      "executionEntrypoint": "main",
      "kind": "polling_trigger",
      "inputPorts": [
        {
          "key": "input",
          "label": "Input",
          "type": "object"
        }
      ],
      "outputPorts": [
        {
          "key": "record",
          "label": "Issue or pull request",
          "type": "object"
        }
      ],
      "connectionRequirements": [
        {
          "reference": "connection",
          "provider": "github_app",
          "permissions": [
            "issues.read",
            "pull_requests.read"
          ],
          "required": true
        }
      ],
      "fileInputs": [],
      "placements": [
        "desktop",
        "self_hosted"
      ],
      "externalEffect": "read"
    },
