    {
      "nodeType": "slack.channel_message_posted",
      "nodeVersion": 1,
      "displayName": "Slack Message Posted",
      "description": "Starts when a channel receives a new message.",
      "category": "Triggers",
      "riskLevel": "low",
      "inputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "configurationSchema": {
        "type": "object",
        "properties": {
          "connectionId": {
            "type": "string",
            "title": "Connection",
            "format": "connection",
            "x-sndbox-provider": "slack_oauth"
          },
          "channelId": {
            "type": "string",
            "title": "Channel"
          },
          "includeBotMessages": {
            "type": "boolean",
            "title": "Include bot messages",
            "default": false
          },
          "includeThreadReplies": {
            "type": "boolean",
            "title": "Include thread replies",
            "default": false
          },
          "pollIntervalSeconds": {
            "type": "integer",
            "title": "Poll interval (seconds)",
            "minimum": 60,
            "maximum": 300,
            "default": 120
          }
        },
        "required": [
          "connectionId",
          "channelId"
        ],
        "additionalProperties": false
      },
      "credentialRequirements": [
        "slack_oauth"
      ],
      "capabilities": [
        "credential_operations:slack_oauth",
        "structured_logging"
      ],
      "timeoutMs": 30000,
      "retryBehavior": "safe",
      "idempotencySupport": "read_only",
      "documentation": "docs/slack.channel_message_posted.md",
      "migrationHandlers": [],
      "executionEntrypoint": "main",
      "kind": "polling_trigger",
      "inputPorts": [
        {
          "key": "input",
          "label": "Input",
          "type": "object"
        }
      ],
      "outputPorts": [
        {
          "key": "message",
          "label": "Message",
          "type": "object"
        }
      ],
      "connectionRequirements": [
        {
          "reference": "connection",
          "provider": "slack_oauth",
          "permissions": [
            "messages.read"
          ],
          "required": true
        }
      ],
      "fileInputs": [],
      "placements": [
        "desktop",
        "self_hosted"
      ],
      "externalEffect": "read"
    },
