{
  "name": "@sandbox/docs",
  "version": "0.7.1-beta.3",
  "private": true,
  "scripts": {
    "generate:references": "tsx ../../scripts/generate-docs-reference.ts",
    "predev": "npm run generate:references",
    "dev": "mint dev --port 3200 --no-open",
    "prebuild": "npm run generate:references",
