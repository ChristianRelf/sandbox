    { "source": "/browser-automation/frames-and-tabs", "destination": "/browser-automation/navigation-and-waits" },
    { "source": "/files-and-data", "destination": "/files-and-data/overview" },
    { "source": "/execution", "destination": "/execution/overview" },
    { "source": "/execution/retries", "destination": "/execution/retries-and-recovery" },
    { "source": "/execution/failure-recovery", "destination": "/execution/retries-and-recovery" },
    { "source": "/plugins", "destination": "/plugins/overview" },
    { "source": "/plugins/permissions", "destination": "/plugins/capabilities-and-permissions" },
    { "source": "/developers", "destination": "/developers/api" },
    { "source": "/developers/cli", "destination": "/plugins/cli-reference" },
