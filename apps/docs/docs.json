{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "sndbox docs",
  "description": "Build, run, inspect, and govern reliable desktop and browser automations.",
  "colors": {
    "primary": "#465200",
    "light": "#d6ff4b",
    "dark": "#647600"
  },
  "favicon": "/assets/sndbox-icon-v2.svg",
  "logo": {
    "light": "/assets/sndbox-wordmark-dark-v2.svg",
    "dark": "/assets/sndbox-wordmark-light-v2.svg",
    "href": "https://sndbox.app"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "navigation": {
