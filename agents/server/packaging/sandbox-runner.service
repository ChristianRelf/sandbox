[Unit]
Description=[PRODUCT_NAME] self-hosted workflow runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sandbox-runner
Group=sandbox-runner
ExecStart=/usr/local/bin/sandbox-runner --config /etc/sandbox-runner/config.toml run
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sandbox-runner

[Install]
WantedBy=multi-user.target
