# Create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_CHANNEL_ID=replace-with-the-target-channel-id

# The GitHub repository whose Releases page is the changelog source.
GITHUB_REPOSITORY=ChristianRelf/sandbox

# Optional. Recommended for private repositories or higher API rate limits.
GITHUB_TOKEN=

# Poll every five minutes. GitHub allows unauthenticated API requests, but keep
# this at 60 seconds or greater.
POLL_INTERVAL_SECONDS=300

# Include beta/RC releases and announce the latest release on the first run.
INCLUDE_PRERELEASES=true
POST_LATEST_ON_START=true

# Optional. Relative paths are resolved from this bot directory.
STATE_FILE=.data/state.json

# Optional readiness marker used by the production container health check.
HEALTH_FILE=
