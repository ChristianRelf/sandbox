config_version = 1
control_plane_url = "https://control.example.com"
runner_name = "digitalocean-beta-runner"
workspace_id = "replace-with-workspace-id"
environment_id = "replace-with-environment-id"
environment = "beta"
tags = ["linux", "digitalocean", "always-on"]
concurrency = 1
data_directory = "/var/lib/sandbox-runner"
plugin_cache = "/var/lib/sandbox-runner/plugins"
allowed_working_directories = ["/srv/automation"]
approved_network_targets = []
log_level = "info"
update_channel = "beta"
update_mode = "notify_only"
pinned_version_range = ">=0.7.2-beta.3,<0.8"
drain_timeout_seconds = 60
enable_managed_chromium = false
allow_simple_commands = false

# Replace this example with the control plane's Ed25519 command-signing public key.
[command_signing_keys]
beta-release = "replace-with-command-signing-public-key"

[certificate]
